    "custom_html_3V3N37": {
      "type": "custom-html",
      "name": "Custom HTML",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "html": "<div style=\"padding:40px 0; position:relative;\">\n\n  <!-- HEADER -->\n  <div style=\"text-align:center; margin-bottom:30px;\">\n    <div style=\"\n      color:#00e0b8;\n      font-size:13px;\n      letter-spacing:2px;\n      text-transform:uppercase;\n      margin-bottom:8px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:10px;\n    \">\n      <span style=\"height:1px; width:40px; background:#00e0b8;\"></span>\n      Stimule l’éveil et la créativité\n      <span style=\"height:1px; width:40px; background:#00e0b8;\"></span>\n    </div>\n\n    <h2 style=\"color:white; font-size:28px; font-weight:700; margin:0;\">\n      Comment ça marche ?\n    </h2>\n  </div>\n\n  <!-- CAROUSEL -->\n  <div id=\"carousel\" style=\"\n    display:flex;\n    gap:16px;\n    overflow-x:auto;\n    scroll-behavior:smooth;\n    -webkit-overflow-scrolling:touch;\n    scroll-snap-type:x mandatory;\n    padding:0 40px;\n  \">\n\n    <!-- CARD 1 -->\n    <div style=\"flex:0 0 85%; background:#0b0b0b; border-radius:16px; overflow:hidden; border:1px solid #1a1a1a; scroll-snap-align:center;\">\n      <video autoplay=\"\" muted=\"\" loop=\"\" playsinline=\"\" style=\"width:100%;\">\n        <source src=\"https://cdn.shopify.com/videos/c/o/v/281596c8e4ad43cda4c32f96507a0501.mp4\">\n      </source></video>\n      <div style=\"padding:16px;\">\n        <div style=\"color:#00e0b8; font-weight:600;\">Dessiner avec la lumière</div>\n        <div style=\"color:#cfcfcf; font-size:14px; margin-top:6px;\">\n          Utilisez le stylet inclus pour dessiner tout ce que vous voulez — pas de feutres salissants, pas d’encre, juste de la lumière pure.\n        </div>\n\n        <!-- BADGE -->\n        <div style=\"\n          margin-top:12px;\n          display:inline-block;\n          padding:6px 12px;\n          border-radius:20px;\n          background:rgba(0,224,184,0.1);\n          color:#00e0b8;\n          font-size:12px;\n          font-weight:600;\n        \">\n          ✏️ STYLET INCLUS\n        </div>\n      </div>\n    </div>\n\n    <!-- CARD 2 -->\n    <div style=\"flex:0 0 85%; background:#0b0b0b; border-radius:16px; overflow:hidden; border:1px solid #1a1a1a; scroll-snap-align:center;\">\n      <video autoplay=\"\" muted=\"\" loop=\"\" playsinline=\"\" style=\"width:100%;\">\n        <source src=\"https://cdn.shopify.com/videos/c/o/v/1fedb5c268e84895b2a01d5f0eaebdd1.mp4\">\n      </source></video>\n      <div style=\"padding:16px;\">\n        <div style=\"color:#00e0b8; font-weight:600;\">L’éclat apparaît instantanément</div>\n        <div style=\"color:#cfcfcf; font-size:14px; margin-top:6px;\">\n          Observez une lueur turquoise éclatante se répandre sur la peluche à l’endroit précis où vous avez dessiné. Comme par magie.\n        </div>\n\n        <!-- BADGE -->\n        <div style=\"\n          margin-top:12px;\n          display:inline-block;\n          padding:6px 12px;\n          border-radius:20px;\n          background:rgba(0,224,184,0.1);\n          color:#00e0b8;\n          font-size:12px;\n          font-weight:600;\n        \">\n          ✨ ÉCLAT INSTANTANÉ\n        </div>\n      </div>\n    </div>\n\n    <!-- CARD 3 -->\n    <div style=\"flex:0 0 85%; background:#0b0b0b; border-radius:16px; overflow:hidden; border:1px solid #1a1a1a; scroll-snap-align:center;\">\n      <video autoplay=\"\" muted=\"\" loop=\"\" playsinline=\"\" style=\"width:100%;\">\n        <source src=\"https://cdn.shopify.com/videos/c/o/v/90e06c20fa3746aebc157a6379ba270f.mp4\">\n      </source></video>\n      <div style=\"padding:16px;\">\n        <div style=\"color:#00e0b8; font-weight:600;\">Souriez et répétez</div>\n        <div style=\"color:#cfcfcf; font-size:14px; margin-top:6px;\">\n          La lueur disparaît naturellement en quelques minutes, sans taches ni résidus. Puis recommencez à l’infini.\n        </div>\n\n        <!-- BADGE -->\n        <div style=\"\n          margin-top:12px;\n          display:inline-block;\n          padding:6px 12px;\n          border-radius:20px;\n          background:rgba(0,224,184,0.1);\n          color:#00e0b8;\n          font-size:12px;\n          font-weight:600;\n        \">\n          ⏱ S’ESTOMPE EN 10 MIN\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- BOUTONS -->\n  <button onclick=\"scrollCarousel(-1)\" style=\"\n    position:absolute;\n    left:5px;\n    top:55%;\n    transform:translateY(-50%);\n    background:#111;\n    color:white;\n    border:none;\n    border-radius:50%;\n    width:36px;\n    height:36px;\n    cursor:pointer;\n    z-index:10;\n  \">‹</button>\n\n  <button onclick=\"scrollCarousel(1)\" style=\"\n    position:absolute;\n    right:5px;\n    top:55%;\n    transform:translateY(-50%);\n    background:#111;\n    color:white;\n    border:none;\n    border-radius:50%;\n    width:36px;\n    height:36px;\n    cursor:pointer;\n    z-index:10;\n  \">›</button>\n\n  <!-- SCRIPT -->\n  <script>\n    function scrollCarousel(direction){\n      const container = document.getElementById('carousel');\n      const scrollAmount = container.offsetWidth * 0.85;\n      container.scrollBy({\n        left: direction * scrollAmount,\n        behavior: 'smooth'\n      });\n    }\n  </script>\n\n  <!-- HIDE SCROLLBAR -->\n  <style>\n    #carousel::-webkit-scrollbar {\n      display: none;\n    }\n  </style>\n\n</div>",
